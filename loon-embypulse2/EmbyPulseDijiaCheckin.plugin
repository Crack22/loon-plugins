#!name=乐观每日签到
#!desc=每天 09:00 自动签到 https://embyyh.dijia.de/，签到奖励 90-130 积分。\n装好插件后打开这个站一次，就会自动抓取 Cookie 保存（键 embypulse2_session_id），不用手动粘贴；也可以在 BoxJs 里手动粘贴 session_id。\nCookie 只保存在你手机本地，不会上传；过期了重新打开一次这个站就行。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

[Script]
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-embypulse2/embypulse_dijia_checkin.js, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/leguan.jpg, tag=乐观签到, enable=true
http-request ^https?://embyyh\.dijia\.de/ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-embypulse2/embypulse_dijia_cookie.js, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/leguan.jpg, requires-body=false, tag=乐观Cookie抓取, enable=true

[MITM]
hostname = embyyh.dijia.de
