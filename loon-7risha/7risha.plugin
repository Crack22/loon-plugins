#!name=七日杀每日签到
#!desc=七日杀中文网每日签到，只需点签到按钮即可成功，无需人机验证；用法：开重写+cron，打开签到页 https://www.7risha.com/sign 停 1 秒，收到 7risha Cookie 获取成功即抓取成功，签到时间在 BoxJs 里设置，默认 08:30，也可以指定时间或在时间区间内随机
#!author=許諾
#!icon=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/7risha.jpg
#!tag=七日杀
#!system=ios

# 用法：
# 1、安装插件，开启重写脚本 + cron
# 2、打开「七日杀中文网」签到页 https://www.7risha.com/sign 停留 1 秒
# 3、收到 ✅ 7risha Cookie 获取成功 通知即抓取成功
# 4、cron 每天 08:30 自动签到
[MITM]
hostname = www.7risha.com

[Script]
http-request ^https:\/\/www\.7risha\.com\/sign tag=7risha Cookie, script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-7risha/7risha_cookie.js, requires-body=false, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/7risha.jpg
cron "* * * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-7risha/7risha_checkin.js, tag=七日杀签到, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/7risha.jpg, enable=true
