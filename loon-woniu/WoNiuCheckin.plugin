#!name=蜗牛每日签到
#!desc=蜗牛 4K 每日签到，每天 +10 积分；用法：开重写+cron，打开蜗牛签到页停 1 秒，收到蜗牛 Cookie 获取成功即抓取成功，cron 每天 09:00 触发
#!author=許諾
#!tag=蜗牛
#!system=ios

# 用法：
# 1、安装插件，开启重写脚本 + cron
# 2、打开「蜗牛」签到页 https://www.wn4k.com/user/checkin.html 停留 1 秒
# 3、收到 ✅ 蜗牛 Cookie 获取成功 通知即抓取成功
# 4、cron 每天 09:00 自动签到
[MITM]
hostname = www.wn4k.com

[Script]
http-request ^https:\/\/www\.wn4k\.com\/user\/checkin\.html tag=蜗牛 Cookie, script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-woniu/woniu_cookie.js, requires-body=false, img-url=https://woniu.qljiang.com/weixin_files/woniu_white.png
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-woniu/woniu_checkin.js, tag=蜗牛签到, img-url=https://woniu.qljiang.com/weixin_files/woniu_white.png, enable=true
