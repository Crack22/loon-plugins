#!name=乐蛙每日签到
#!desc=每天 09:00 自动签到 https://ue2.taotu.ink/，签到奖励 100-120 积分。\nCookie 和账号密码二选一，账号数量不限：在 BoxJs 里填 session_id（打开这个站一次可自动抓取），或填账号密码自动登录；Cookie 过期时有账号密码会自动重新登录。\n多账号：在 BoxJs 的「多账号」里每行填一个 session_id 或 账号----密码；「登录账号数量」填数字只签前 N 个，空着就是全部都签。\nCookie 和密码只保存在你手机本地，不会上传。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

[Script]
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-embypulse1/embypulse_taotu_checkin.js, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/lewa.jpg, tag=乐蛙签到, enable=true
http-request ^https?://ue2\.taotu\.ink/ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-embypulse1/embypulse_taotu_cookie.js, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/lewa.jpg, requires-body=false, tag=乐蛙Cookie抓取, enable=true

[MITM]
hostname = ue2.taotu.ink
