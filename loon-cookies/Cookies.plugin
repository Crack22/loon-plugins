#!name=获取 Cookie 合集
#!desc=各 App 抓取 Cookie / Token 的合集：装好后在插件设置里按需打开要抓的服务，打开对应 App 完成抓取后可以关掉开关。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/others/cookie.png
#!system = iOS, iPadOS

[Argument]
acfun = switch,true,tag=AcFun
apktw = switch,true,tag=APK.TW
aliyunpan = switch,true,tag=阿里云盘
aliyunpan2 = switch,true,tag=阿里云盘
iqiyi = switch,true,tag=爱奇艺
bing = switch,true,tag=bing获取积分
