http-request https:\/\/www.maomicd.com\/plugin.php\?id=k_misign:sign&operation=qiandao script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/maomicd/maomicd.cookie.js, timeout=60, tag=猫咪音乐网, enable={maomicd}, argument=[{maomicd}]



# >>>>>>>>>>>>>>> ✅ N ✅ <<<<<<<<<<<<<<
