#!name=IP 查询
#!desc=合并 ip.cx 和 iplark.com 的功能：在节点界面长按一个节点，点菜单里的「IP 查询」，查这个节点出口 IP 的归属地、ISP、ASN、时区、多源定位对比，并检测 Google、YouTube、GitHub、ChatGPT、百度、淘宝的连通性。\n也可以在 BoxJs 里填一个指定 IP 来查。\n数据来自免费接口 ip-api.com + ipinfo.io，不用 key。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/ipinfo.png
#!homepage=https://github.com/Crack22/loon-plugins

[Script]
generic then script("https://raw.githubusercontent.com/Crack22/loon-plugins/5b3492834ad9ecda9b75d427cfa2c748193a8a04/loon-ip/ip_info.js") with tag="IP 查询", img_url="https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/ipinfo.png", timeout=65
