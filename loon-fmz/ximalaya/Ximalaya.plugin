#!name=喜马拉雅每日签到
#!desc=喜马拉雅每日签到；用法：装好插件，打开重写和 cron，打开「喜马拉雅」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:03 自动签到。\n手动抓取：点 Loon 脚本里的「喜马拉雅去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/ximalaya.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = mobwsa.ximalaya.com

[Script]
http-request ^https?://mobwsa\.ximalaya\.com/.*mobile-user/homePage/ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=喜马拉雅每日签到 Cookie, argument="key=chavy_cookie_ximalaya&source=cookie&title=喜马拉雅", enable={capture}
cron "3 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/ximalaya/ximalaya.js, timeout=300, tag=喜马拉雅每日签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/ximalaya.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=喜马拉雅去抓取, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/ximalaya.png, argument="title=喜马拉雅&url=&hint=打开「喜马拉雅」停留几秒即自动抓取", enable={capture}
