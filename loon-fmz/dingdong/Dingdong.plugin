#!name=叮咚买菜每日签到
#!desc=叮咚买菜每日签到；用法：装好插件，打开重写和 cron，打开「叮咚买菜」App 积分首页，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:06 自动签到。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（mcdd.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = maicai.api.ddxq.mobi

[Script]
http-request ^https://maicai\.api\.ddxq\.mobi/point/home script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/dingdong/dingdong_capture.js, requires-body=false, tag=叮咚买菜 Cookie, argument="title=叮咚买菜", enable={capture}
cron "6 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/mcdd/mcdd.js, timeout=300, tag=叮咚买菜签到, enable=true
