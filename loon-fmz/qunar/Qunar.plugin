#!name=去哪儿每日签到
#!desc=去哪儿每日签到；用法：装好插件，打开重写和 cron，打开「去哪儿」点一次签到，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:02 自动签到。\n手动抓取：点 Loon 脚本里的「去哪儿去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（qunar.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = user.qunar.com

[Script]
http-request ^https?://user\.qunar\.com/webapi/member/sign(NewIndex|IndexV2)\.htm script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/qunar/qunar_capture.js, requires-body=false, tag=去哪儿每日签到 Cookie, argument="key=chavy_cookie_qunar&title=去哪儿", enable={capture}
cron "2 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/qunar/qunar.js, timeout=300, tag=去哪儿每日签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=去哪儿去抓取, argument="title=去哪儿&url=&hint=打开「去哪儿」点一次签到即自动抓取", enable={capture}
