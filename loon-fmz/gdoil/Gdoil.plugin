#!name=加油广东每日签到
#!desc=加油广东每日签到；用法：装好插件，打开重写和 cron，打开「加油广东」App 手动签到一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:04 自动签到。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（gdoil.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = m.gdoil.cn

[Script]
http-request ^https://m\.gdoil\.cn/webapi/usersign/addusersign script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/gdoil/gdoil_capture.js, requires-body=false, tag=加油广东 Cookie, argument="title=加油广东", enable={capture}
cron "4 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/gdoil/gdoil.js, timeout=300, tag=加油广东签到, enable=true
