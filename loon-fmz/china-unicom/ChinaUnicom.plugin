#!name=中国联通每日签到
#!desc=中国联通每日签到；用法：装好插件，打开重写和 cron，打开「中国联通」App 签到页，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:05 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/China_Unicom.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（10010.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = act.10010.com, m.client.10010.com

[Script]
http-request ^https?://act\.10010\.com/SigninApp/signin/querySigninActivity\.htm script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/china-unicom/china-unicom_capture.js, requires-body=false, tag=中国联通 Cookie, argument="title=中国联通", enable={capture}
http-request ^https?://act\.10010\.com/SigninApp(.*?)/signin/daySign script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/china-unicom/china-unicom_capture.js, requires-body=false, tag=中国联通 Cookie, argument="title=中国联通", enable={capture}
http-request ^https?://m\.client\.10010\.com/dailylottery/static/(textdl/userLogin|active/findActivityInfo) script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/china-unicom/china-unicom_capture.js, requires-body=false, tag=中国联通 Cookie, argument="title=中国联通", enable={capture}
cron "5 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/10010/10010.js, timeout=300, tag=中国联通签到, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/China_Unicom.png, enable=true
