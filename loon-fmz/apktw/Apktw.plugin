#!name=APK.TW每日签到
#!desc=APK.TW每日签到；用法：装好插件，打开重写和 cron，打开「APK.TW」登录一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:03 自动签到。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（apktw.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = apk.tw

[Script]
http-request ^https?://apk\.tw/member\.php\?mod=logging&action=login script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/apktw/apktw_capture.js, requires-body=true, tag=APK.TW每日签到 Cookie, argument="key=chavy_cookie_apktw&title=APK.TW", enable={capture}
cron "3 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/apktw/apktw.js, timeout=300, tag=APK.TW每日签到, enable=true
