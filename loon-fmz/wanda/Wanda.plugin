#!name=万达电影每日签到
#!desc=万达电影每日签到；用法：装好插件，打开重写和 cron，打开「万达电影」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 02:12 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/06jichang/wanda.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（wanda.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = user-api-prd-mx.wandafilm.com

[Script]
http-request ^https?://user-api-prd-mx\.wandafilm\.com script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/wanda/wanda_capture.js, requires-body=false, tag=万达电影 Cookie, argument="title=万达电影", enable={capture}
cron "12 2 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/wanda/wanda.js, timeout=300, tag=万达电影签到, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/06jichang/wanda.png, enable=true
