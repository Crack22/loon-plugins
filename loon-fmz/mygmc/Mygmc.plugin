#!name=民盈国贸城每日签到
#!desc=民盈国贸城每日签到；用法：装好插件，打开重写和 cron，打开「民盈国贸城」小程序停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 00:15 自动签到。\n手动抓取：点 Loon 脚本里的「民盈国贸城去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：XidNDD/2020scripts（mygmcSign.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = appsmall.rtmap.com

[Script]
http-request ^https?://appsmall\.rtmap\.com/.*(sign/signRecord|wxapp-root/api/v1/(score/account|customer/info)) script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/mygmc/mygmc_capture.js, requires-body=true, tag=民盈国贸城 Cookie, argument="title=民盈国贸城", enable={capture}
cron "15 0 * * *" script-path=https://raw.githubusercontent.com/XidNDD/2020scripts/master/mygmcSign.js, timeout=300, tag=民盈国贸城签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=民盈国贸城去抓取, argument="title=民盈国贸城&url=&hint=打开「民盈国贸城」小程序停留几秒即自动抓取", enable={capture}
