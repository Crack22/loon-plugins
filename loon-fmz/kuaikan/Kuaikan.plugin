#!name=快看漫画每日签到
#!desc=快看漫画每日签到；用法：装好插件，打开重写和 cron，打开「快看漫画」点「我的」，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 09:04 自动签到。\n手动抓取：点 Loon 脚本里的「快看漫画去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：NobyDa/Script（KKMH.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = api.kkmh.com

[Script]
http-request ^https?://api\.kkmh\.com/v\d/passport/user script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/kuaikan/kuaikan_capture.js, requires-body=false, tag=快看漫画每日签到 Cookie, argument="key=KKMH&title=快看漫画", enable={capture}
cron "4 9 * * *" script-path=https://raw.githubusercontent.com/NobyDa/Script/master/KuaiKan-DailyBonus/KKMH.js, timeout=300, tag=快看漫画每日签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=快看漫画去抓取, argument="title=快看漫画&url=&hint=打开「快看漫画」点「我的」即自动抓取", enable={capture}
