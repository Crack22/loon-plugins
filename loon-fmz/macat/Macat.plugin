#!name=马克喵签到
#!desc=马克喵签到；用法：装好插件，打开重写和 cron，打开马克喵网站登录一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 7:22 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Macat.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：fmz200/wool_scripts（macat_signin.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = www.macat.vip

[Script]
http-request ^https://www\.macat\.vip/wp-admin/admin-ajax\.php$ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/macat/macat_capture.js, requires-body=true, tag=马克喵签到抓取, enable={capture}
cron "22 7 * * *" script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/macat/macat_signin.js, timeout=300, tag=马克喵签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Macat.png, enable=true
