#!name=猫咪音乐每日签到
#!desc=猫咪音乐每日签到；用法：装好插件，打开重写和 cron，打开「猫咪音乐」App 手动签到一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:05 自动签到。\n手动抓取：点 Loon 脚本里的「猫咪音乐去抓取」，点弹出的通知即打开抓取页。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = www.maomicd.com

[Script]
http-request ^https://www\.maomicd\.com/plugin\.php\?id=k_misign:sign&operation=qiandao script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/maomicd/maomicd_capture.js, requires-body=false, tag=猫咪音乐 Cookie, argument="title=猫咪音乐", enable={capture}
cron "5 8 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/maomicd/maomicd.js, timeout=300, tag=猫咪音乐签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=猫咪音乐去抓取, argument="title=猫咪音乐&url=https%3A%2F%2Fwww.maomicd.com%2Fplugin.php%3Fid%3Dk_misign%3Asign%26operation%3Dqiandao&hint=在浏览器里打开猫咪音乐签到页，停留几秒即自动抓取", enable={capture}
