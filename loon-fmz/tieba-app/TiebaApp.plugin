#!name=百度贴吧(客户端)每日签到
#!desc=百度贴吧(客户端)每日签到；用法：装好插件，打开重写和 cron，打开「百度贴吧」客户端登录后停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 8:00、8:01、8:02 自动签到。\n手动抓取：点 Loon 脚本里的「百度贴吧(客户端)去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/baidutieba.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：NobyDa/Script（TieBa.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = c.tieba.baidu.com, tiebac.baidu.com

[Script]
http-request ^https?://(c\.tieba|tiebac)\.baidu\.com/c/s/login script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=百度贴吧(客户端)每日签到 Cookie, argument="key=CookieTB&source=cookie&title=百度贴吧(客户端)每日签到", enable={capture}
cron "0,1,2 8 * * *" script-path=https://raw.githubusercontent.com/NobyDa/Script/master/BDTieBa-DailyBonus/TieBa.js, timeout=300, tag=百度贴吧(客户端)每日签到, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/baidutieba.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=百度贴吧(客户端)去抓取, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/baidutieba.png, argument="title=百度贴吧(客户端)&url=&hint=打开「百度贴吧」客户端登录后停留几秒即自动抓取", enable={capture}
