#!name=爱奇艺每日签到
#!desc=爱奇艺每日签到；用法：装好插件，打开重写和 cron，打开「爱奇艺」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 8:01 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/iqiyi.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：NobyDa/Script（iQIYI.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = passport.iqiyi.com

[Script]
http-request ^https?://passport\.iqiyi\.com/apis/user/ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=爱奇艺每日签到 Cookie, argument="key=CookieQY&source=cookie&title=爱奇艺每日签到", enable={capture}
cron "1 8 * * *" script-path=https://raw.githubusercontent.com/NobyDa/Script/master/iQIYI-DailyBonus/iQIYI.js, timeout=300, tag=爱奇艺每日签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/iqiyi.png, enable=true
