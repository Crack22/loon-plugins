#!name=南方周末每日签到
#!desc=南方周末每日签到；用法：装好插件，打开重写和 cron，打开「南方周末」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 02:11 自动签到。\n手动抓取：点 Loon 脚本里的「南方周末去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（nfzm.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = api.infzm.com

[Script]
http-request ^https?://api\.infzm\.com/mobile/pumpkin_task/complete script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/nfzm/nfzm_capture.js, requires-body=false, tag=南方周末 Cookie, argument="title=南方周末", enable={capture}
cron "11 2 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/nfzm/nfzm.js, timeout=300, tag=南方周末签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=南方周末去抓取, argument="title=南方周末&url=&hint=打开「南方周末」停留几秒即自动抓取", enable={capture}
