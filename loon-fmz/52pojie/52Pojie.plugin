#!name=吾爱破解每日签到
#!desc=吾爱破解每日签到；用法：装好插件，打开重写和 cron，用浏览器打开吾爱破解个人中心页（www.52pojie.cn/home.php）并登录，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 8:01 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/52pojie.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：NobyDa/Script（52pojie.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = www.52pojie.cn

[Script]
http-request ^https?://www\.52pojie\.cn/home\.php\? script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=吾爱破解每日签到 Cookie, argument="key=COOKIE&source=cookie&title=吾爱破解每日签到", enable={capture}
cron "1 8 * * *" script-path=https://raw.githubusercontent.com/NobyDa/Script/master/52pojie-DailyBonus/52pojie.js, timeout=300, tag=吾爱破解每日签到, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/52pojie.png, enable=true
