#!name=微信小程序-同程艺龙每日签到
#!desc=微信小程序-同程艺龙每日签到；用法：装好插件，打开重写和 cron，打开微信小程序「同程艺龙」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:10 自动签到。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：barrym-chen/Script（tongc/tongc_sign.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = wx.17u.cn

[Script]
http-request ^https?://wx\.17u\.cn/wcsign/sign/SaveSignInfo script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/tongcheng/tongcheng_capture.js, requires-body=true, tag=微信小程序-同程艺龙 Cookie, argument="title=微信小程序-同程艺龙", enable={capture}
cron "10 8 * * *" script-path=https://raw.githubusercontent.com/barrym-chen/Script/master/tongc/tongc_sign.js, timeout=300, tag=微信小程序-同程艺龙签到, enable=true
