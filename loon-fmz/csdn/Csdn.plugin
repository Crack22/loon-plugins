#!name=CSDN每日签到
#!desc=CSDN每日签到；用法：装好插件，打开重写和 cron，打开「CSDN」App 并手动签到一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:04 自动签到。\n手动抓取：点 Loon 脚本里的「CSDN去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（csdn.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = passport.csdn.net, gw.csdn.net

[Script]
http-request ^https://passport\.csdn\.net/v2/api/app/login/checkAndRefreshToken script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/csdn/csdn_capture.js, requires-body=false, tag=CSDN Cookie, argument="title=CSDN", enable={capture}
http-request ^https://gw\.csdn\.net/mini-app/v2/lucky_draw/login/sign_in\? script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/csdn/csdn_capture.js, requires-body=false, tag=CSDN Cookie, argument="title=CSDN", enable={capture}
cron "4 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/csdn/csdn.js, timeout=300, tag=CSDN签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=CSDN去抓取, argument="title=CSDN&url=&hint=打开「CSDN」App 并手动签到一次即自动抓取", enable={capture}
