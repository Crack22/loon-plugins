#!name=Funboat签到
#!desc=Funboat签到；用法：装好插件，打开重写和 cron，打开微信小程序 Funboat，点「我的」并手动签到一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 8:04 自动签到。\n手动抓取：点 Loon 脚本里的「Funboat去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = h5.youzan.com

[Script]
http-request ^https?://h5\.youzan\.com/wsc.*app_id=wx9b5caf9d1669dc96 script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/funboat/funboat_capture.js, tag=Funboat签到抓取, enable={capture}
cron "4 8 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/funboat/funboat.js, timeout=300, tag=Funboat签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=Funboat去抓取, argument="title=Funboat&url=&hint=打开微信小程序 Funboat，点「我的」并手动签到一次即自动抓取", enable={capture}
