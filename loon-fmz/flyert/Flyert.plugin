#!name=飞客-签到
#!desc=飞客-签到；用法：装好插件，打开重写和 cron，打开「飞客」App 浏览一下，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 0:10 自动签到。\n手动抓取：点 Loon 脚本里的「飞客去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/flyert.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：zirawell/R-Store（flyert.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = www.flyert.com.cn

[Script]
http-request ^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=getdata&.* script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/flyert/flyert_capture.js, tag=飞客-签到抓取, enable={capture}
cron "10 0 * * *" script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/CheckIn/flyert.js, timeout=300, tag=飞客-签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/flyert.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=飞客去抓取, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/flyert.png, argument="title=飞客&url=&hint=打开「飞客」App 浏览一下即自动抓取", enable={capture}
