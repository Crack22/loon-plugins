#!name=京东每日签到
#!desc=京东每日签到；用法：装好插件，打开重写和 cron，用 Safari 登录京东个人中心页（home.m.jd.com），收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 1:15 自动签到。\n手动抓取：点 Loon 脚本里的「京东去抓取」，点弹出的通知即打开抓取页。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/jingdong.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = api.m.jd.com, me-api.jd.com, ms.jr.jd.com

[Script]
http-request ^https?://(api\.m|me-api|ms\.jr)\.jd\.com/(client\.action\?functionId=signBean|user_new/info/GetJDUserInfoUnion\?|gw/generic/hy/h5/m/appSign\?) script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=京东每日签到 Cookie, argument="key=CookiesJD&source=cookie&title=京东每日签到", enable={capture}
cron "15 1 * * *" script-path=https://raw.githubusercontent.com/NobyDa/Script/master/JD-DailyBonus/JD_DailyBonus.js, timeout=300, tag=京东每日签到, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/jingdong.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=京东去抓取, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/jingdong.png, argument="title=京东&url=https%3A%2F%2Fhome.m.jd.com%2FmyJd%2Fnewhome.action&hint=在 Safari 里登录京东，停留几秒即自动抓取", enable={capture}
