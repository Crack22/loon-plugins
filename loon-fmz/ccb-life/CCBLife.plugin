#!name=建行生活签到
#!desc=建行生活签到；用法：装好插件，打开重写和 cron，打开「建行生活」手动签到一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 7:17 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/ccbLife.jpg
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：FoKit/Scripts（jhsh_checkIn.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = yunbusiness.ccb.com

[Script]
http-request ^https://yunbusiness\.ccb\.com/(clp_coupon|clp_service)/txCtrl\?txcode=(A3341A038|autoLogin) script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/ccb-life/ccb-life_capture.js, requires-body=true, tag=建行生活签到抓取, enable={capture}
cron "17 7 * * *" script-path=https://raw.githubusercontent.com/FoKit/Scripts/main/scripts/jhsh_checkIn.js, timeout=300, tag=建行生活签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/ccbLife.jpg, enable=true
