#!name=晓晓优选每日任务
#!desc=晓晓优选每日任务；用法：装好插件，打开重写和 cron，打开「晓晓优选」点一下「我的」，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 7:17 自动签到。\n手动抓取：点 Loon 脚本里的「晓晓优选去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/xxyx.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = xxyx-client-api.xiaoxiaoyouxuan.com

[Script]
http-response ^https://xxyx-client-api\.xiaoxiaoyouxuan\.com/my script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/xxyx/xxyx_capture.js, requires-body=true, tag=晓晓优选每日任务抓取, enable={capture}
cron "17 7 * * *" script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/xxyx/xxyx_signin.js, timeout=300, tag=晓晓优选每日任务, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/xxyx.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=晓晓优选去抓取, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/xxyx.png, argument="title=晓晓优选&url=&hint=打开「晓晓优选」点一下「我的」即自动抓取", enable={capture}
