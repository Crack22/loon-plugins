#!name=京东成长分每日签到
#!desc=京东成长分每日签到；用法：装好插件，打开重写和 cron，打开「京东金融」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:10 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/JD.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：barrym-chen/Script（jdczf/jdczf.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = ms.jr.jd.com

[Script]
http-request ^https?://ms\.jr\.jd\.com/ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=京东成长分 Cookie, argument="key=chen_cookie_jingdong&source=cookie&title=京东成长分", enable={capture}
cron "10 8 * * *" script-path=https://raw.githubusercontent.com/barrym-chen/Script/master/jdczf/jdczf.js, timeout=300, tag=京东成长分签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/JD.png, enable=true
