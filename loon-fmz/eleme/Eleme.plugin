#!name=饿了么每日签到
#!desc=饿了么每日签到；用法：装好插件，打开重写和 cron，打开「饿了么」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:09 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Element.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：songyangzz/QuantumultX（elem/elemSign.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = h5.ele.me

[Script]
http-request ^https?://h5\.ele\.me/restapi/eus/v\d/current_user script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=饿了么 Cookie, argument="key=cookie_elem&source=cookie&title=饿了么", enable={capture}
cron "9 8 * * *" script-path=https://raw.githubusercontent.com/songyangzz/QuantumultX/master/elem/elemSign.js, timeout=300, tag=饿了么签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Element.png, enable=true
