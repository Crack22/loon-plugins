#!name=NGA刮墙每日签到
#!desc=NGA刮墙每日签到；用法：装好插件，打开重写和 cron，打开「NGA」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 00:10 自动签到。\n手动抓取：点 Loon 脚本里的「NGA刮墙去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = ngabbs.com

[Script]
http-request ^https?://ngabbs\.com/nuke\.php script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/nga/nga_capture.js, requires-body=true, tag=NGA刮墙 Cookie, argument="title=NGA刮墙", enable={capture}
cron "10 0 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/nga/nga.js, timeout=300, tag=NGA刮墙签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=NGA刮墙去抓取, argument="title=NGA刮墙&url=&hint=打开「NGA」停留几秒即自动抓取", enable={capture}
