#!name=携程旅行每日签到
#!desc=携程旅行每日签到；用法：装好插件，打开重写和 cron，打开「携程旅行」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:29 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/xiechenglvxing.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：iepngs/Script（ctrip/index.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = m.ctrip.com

[Script]
http-request ^https?://m\.ctrip\.com/restapi/soa2/14946/json/userBaseInfo script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=携程旅行 Cookie, argument="key=cookie_ctrip&source=cookie&title=携程旅行", enable={capture}
cron "29 8 * * *" script-path=https://raw.githubusercontent.com/iepngs/Script/master/ctrip/index.js, timeout=300, tag=携程旅行签到, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/xiechenglvxing.png, enable=true
