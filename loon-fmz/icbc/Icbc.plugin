#!name=工银e生活每日签到
#!desc=工银e生活每日签到；用法：装好插件，打开重写和 cron，打开「工银e生活」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:10 自动签到。\n手动抓取：点 Loon 脚本里的「工银e生活去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/bank/ICBC.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：barrym-chen/Script（icbc/icbc_sign.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = icbc1.wlphp.com

[Script]
http-request ^https?://icbc1\.wlphp\.com:8444/js/api/index/signIn script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/icbc/icbc_capture.js, requires-body=true, tag=工银e生活 Cookie, argument="title=工银e生活", enable={capture}
cron "10 8 * * *" script-path=https://raw.githubusercontent.com/barrym-chen/Script/master/icbc/icbc_sign.js, timeout=300, tag=工银e生活签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/bank/ICBC.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=工银e生活去抓取, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/bank/ICBC.png, argument="title=工银e生活&url=&hint=打开「工银e生活」停留几秒即自动抓取", enable={capture}
