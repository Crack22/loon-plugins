#!name=今日头条极速版每日签到
#!desc=今日头条极速版每日签到；用法：装好插件，打开重写和 cron，打开「今日头条极速版」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:05–21:35 每 30 分钟 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/jinritoutiao.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：iepngs/Script（jrtt/index.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = is.snssdk.com, i.snssdk.com

[Script]
http-request ^https?://is\.snssdk\.com/score_task/v1/task/(sign_in|get_read_bonus) script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/jrtt/jrtt_capture.js, requires-body=true, tag=今日头条极速版 Cookie, argument="title=今日头条极速版", enable={capture}
http-request ^https?://i\.snssdk\.com/ttgame/game_farm/home_info script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/jrtt/jrtt_capture.js, requires-body=true, tag=今日头条极速版 Cookie, argument="title=今日头条极速版", enable={capture}
cron "5,35 8-21 * * *" script-path=https://raw.githubusercontent.com/iepngs/Script/master/jrtt/index.js, timeout=300, tag=今日头条极速版签到, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/jinritoutiao.png, enable=true
