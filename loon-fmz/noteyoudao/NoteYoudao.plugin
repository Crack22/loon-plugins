#!name=有道云笔记每日签到
#!desc=有道云笔记每日签到；用法：装好插件，打开重写和 cron，打开「有道云笔记」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 03:03 自动签到。\n手动抓取：点 Loon 脚本里的「有道云笔记去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（noteyoudao.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = note.youdao.com

[Script]
http-request ^https://note\.youdao\.com/yws/mapi/user\?method=checkin script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/noteyoudao/noteyoudao_capture.js, requires-body=true, tag=有道云笔记 Cookie, argument="title=有道云笔记", enable={capture}
cron "3 3 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/noteyoudao/noteyoudao.js, timeout=300, tag=有道云笔记签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=有道云笔记去抓取, argument="title=有道云笔记&url=&hint=打开「有道云笔记」停留几秒即自动抓取", enable={capture}
