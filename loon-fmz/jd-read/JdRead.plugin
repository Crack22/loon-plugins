#!name=京东读书
#!desc=京东读书；用法：装好插件，打开重写和 cron，打开「京东读书」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 00:14 自动签到。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：XidNDD/2020scripts（jddsSign.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = jdread-api.jd.com

[Script]
http-request ^https?://jdread-api\.jd\.com/jdread/api/sign script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/jd-read/jd-read_capture.js, requires-body=true, tag=京东读书 Cookie, argument="title=京东读书", enable={capture}
cron "14 0 * * *" script-path=https://raw.githubusercontent.com/XidNDD/2020scripts/master/jddsSign.js, timeout=300, tag=京东读书签到, enable=true
