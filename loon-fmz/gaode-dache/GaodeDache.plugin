#!name=高德地图打车签到
#!desc=高德地图打车签到；用法：装好插件，打开重写和 cron，打开「高德地图」进高德打车福利中心，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 0:01 自动签到。\n手动抓取：点 Loon 脚本里的「高德地图打车去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/GaodeMap.jpg
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = m5.amap.com, m5-zb.amap.com, dache.amap.com

[Script]
http-response ^https?://(m5(|-zb)|dache)\.amap\.com/(ws/yuece/(act|openapi/activity/current)/query|common/(alipaymini|wxmini)\?_ENCRYPT=) script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/gaode-dache/gaode-dache_capture.js, requires-body=true, tag=高德地图打车签到抓取, enable={capture}
cron "1 0 * * *" script-path=https://raw.githubusercontent.com/wf021325/qx/master/task/ampDache.js, timeout=300, tag=高德地图打车签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/GaodeMap.jpg, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=高德地图打车去抓取, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/GaodeMap.jpg, argument="title=高德地图打车&url=&hint=打开「高德地图」进高德打车福利中心即自动抓取", enable={capture}
