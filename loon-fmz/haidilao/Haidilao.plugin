#!name=海底捞每日签到
#!desc=海底捞每日签到；用法：装好插件，打开重写和 cron，打开「海底捞」App 手动签到一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:07 自动签到。\n手动抓取：点 Loon 脚本里的「海底捞去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = activity-1.m.duiba.com.cn

[Script]
http-request ^https://activity-1\.m\.duiba\.com\.cn/signactivity/doSign$ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/haidilao/haidilao_capture.js, requires-body=true, tag=海底捞 Cookie, argument="title=海底捞", enable={capture}
cron "7 8 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/haidilao/hdl.js, timeout=300, tag=海底捞签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=海底捞去抓取, argument="title=海底捞&url=&hint=打开「海底捞」App 手动签到一次即自动抓取", enable={capture}
