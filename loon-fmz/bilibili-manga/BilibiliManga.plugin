#!name=哔哩哔哩漫画每日签到
#!desc=哔哩哔哩漫画每日签到；用法：装好插件，打开重写和 cron，打开「哔哩哔哩漫画」点一下「我的」，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 8:01 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/BiliBili.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：NobyDa/Script（Manga.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = app.bilibili.com

[Script]
http-request ^https://app\.bilibili\.com/x/v2/account/myinfo script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/bilibili-manga/bilibili-manga_capture.js, tag=哔哩哔哩漫画每日签到抓取, enable={capture}
cron "1 8 * * *" script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Bilibili-DailyBonus/Manga.js, timeout=300, tag=哔哩哔哩漫画每日签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/BiliBili.png, enable=true
