#!name=QQ音乐每日签到
#!desc=QQ音乐每日签到；用法：装好插件，打开重写和 cron，在「QQ音乐」里手动签到一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:04 自动签到。\n手动抓取：点 Loon 脚本里的「QQ音乐去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/QQMusic.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = u.y.qq.com

[Script]
http-request ^https?://u\.y\.qq\.com/cgi-bin/musics\.fcg script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/qqmusic/qqmusic_capture.js, requires-body=true, tag=QQ音乐每日签到 Cookie, argument="key=chavy_signurl_qqmusic&title=QQ音乐", enable={capture}
http-response ^https?://u\.y\.qq\.com/cgi-bin/musics\.fcg script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/qqmusic/qqmusic_capture.js, requires-body=true, tag=QQ音乐每日签到 手动签到, enable={capture}
cron "4 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/qqmusic/qqmusic.js, timeout=300, tag=QQ音乐每日签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/QQMusic.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=QQ音乐去抓取, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/QQMusic.png, argument="title=QQ音乐&url=&hint=在「QQ音乐」里手动签到一次即自动抓取", enable={capture}
