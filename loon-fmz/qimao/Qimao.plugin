#!name=七猫小说每日签到
#!desc=七猫小说每日签到；用法：装好插件，打开重写和 cron，打开「七猫小说」App 手动签到一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:07 自动签到。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（qmnovel.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = xiaoshuo.qm989.com

[Script]
http-request ^https://xiaoshuo\.qm989\.com script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/qimao/qimao_capture.js, requires-body=false, tag=七猫小说 Cookie, argument="title=七猫小说", enable={capture}
cron "7 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/qimao/qmnovel.js, timeout=300, tag=七猫小说签到, enable=true
