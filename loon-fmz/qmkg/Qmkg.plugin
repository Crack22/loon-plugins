#!name=全民K歌每日签到
#!desc=全民K歌每日签到；用法：装好插件，打开重写和 cron，打开「全民K歌」App 手动签到一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:06 自动签到。\n手动抓取：点 Loon 脚本里的「全民K歌去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = node.kg.qq.com

[Script]
http-request ^https://node\.kg\.qq\.com/webapp/proxy script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/qmkg/qmkg_capture.js, requires-body=true, tag=全民K歌 Cookie, argument="title=全民K歌", enable={capture}
cron "6 8 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/qmkg/qmkg.js, timeout=300, tag=全民K歌签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=全民K歌去抓取, argument="title=全民K歌&url=&hint=打开「全民K歌」App 手动签到一次即自动抓取", enable={capture}
