#!name=奇瑞汽车App签到
#!desc=奇瑞汽车App签到；用法：装好插件，打开重写和 cron，打开「奇瑞汽车 App」进入「我的」页面，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 7:17 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/chery.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：fmz200/wool_scripts（cheryAppSignin.js；抓取见 Scripts/cookie/get_cookie.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = mobile-consumer-sapp.chery.cn

[Script]
http-response ^https://mobile-consumer-sapp\.chery\.cn/.*web/user/current/details\? script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/chery/chery_capture.js, requires-body=true, tag=奇瑞汽车App签到抓取, enable={capture}
cron "17 7 * * *" script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/chery/cheryAppSignin.js, timeout=300, tag=奇瑞汽车App签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/chery.png, enable=true
