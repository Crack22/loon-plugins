#!name=顺丰速运每日签到
#!desc=顺丰速运每日签到；用法：装好插件，打开重写和 cron，打开「顺丰速运」登录一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:03 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/shunfeng.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（sfexpress.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = mcs-mimp-web.sf-express.com, sf-integral-sign-in.weixinjia.net

[Script]
http-request ^https?://mcs-mimp-web\.sf-express\.com/mcs-mimp/share/.*Redirect script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/sfexpress/sfexpress_capture.js, requires-body=true, tag=顺丰速运每日签到 Cookie, argument="key=chavy_login_sfexpress&title=顺丰速运", enable={capture}
http-request ^https?://sf-integral-sign-in\.weixinjia\.net/app/index script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/sfexpress/sfexpress_capture.js, requires-body=true, tag=顺丰速运每日签到 Cookie, argument="key=chavy_login_sfexpress&title=顺丰速运", enable={capture}
cron "3 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/sfexpress/sfexpress.js, timeout=300, tag=顺丰速运每日签到, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/shunfeng.png, enable=true
