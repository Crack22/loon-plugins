#!name=AcFun每日签到
#!desc=AcFun每日签到；用法：装好插件，打开重写和 cron，打开「AcFun」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:01 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/acfun.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（acfun.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = api-new.app.acfun.cn

[Script]
http-request ^https?://api-new\.app\.acfun\.cn/rest/app/user/personalInfo script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/acfun/acfun_capture.js, requires-body=false, tag=AcFun每日签到 Cookie, argument="key=chavy_cookie_acfun&title=AcFun", enable={capture}
cron "1 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/acfun/acfun.js, timeout=300, tag=AcFun每日签到, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/acfun.png, enable=true
