#!name=美团外卖每日签到
#!desc=美团外卖每日签到；用法：装好插件，打开重写和 cron，打开「美团外卖」App 签到页并手动签到一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:05 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/meituan.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（wmmeituan.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = promotion.waimai.meituan.com

[Script]
http-request ^https://promotion\.waimai\.meituan\.com/playcenter/signIn/entry script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/meituan-waimai/meituan-waimai_capture.js, requires-body=false, tag=美团外卖 Cookie, argument="title=美团外卖", enable={capture}
http-request ^https://promotion\.waimai\.meituan\.com/playcenter/signIn/doaction script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/meituan-waimai/meituan-waimai_capture.js, requires-body=true, tag=美团外卖 Cookie, argument="title=美团外卖", enable={capture}
cron "5 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/wmmeituan/wmmeituan.js, timeout=300, tag=美团外卖签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/meituan.png, enable=true
