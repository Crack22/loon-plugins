#!name=go语言中文网每日签到
#!desc=go语言中文网每日签到；用法：装好插件，打开重写和 cron，打开「go语言中文网」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 09:00 自动签到。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：iepngs/Script（studygolang/index.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = studygolang.com

[Script]
http-request ^https?://studygolang\.com/account/edit script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=go语言中文网 Cookie, argument="key=StudyGolang&source=cookie&title=go语言中文网", enable={capture}
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/iepngs/Script/master/studygolang/index.js, timeout=300, tag=go语言中文网签到, enable=true
