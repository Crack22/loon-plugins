#!name=IT之家每日签到
#!desc=IT之家每日签到；用法：装好插件，打开重写和 cron，打开「IT之家」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 02:11 自动签到。\n手动抓取：点 Loon 脚本里的「IT之家去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/ithome.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = napi.ithome.com

[Script]
http-request ^https?://napi\.ithome\.com/api/usersign/getsigninfo script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=IT之家 Cookie, argument="key=senku_ithome_userHash&source=query:userHash&title=IT之家", enable={capture}
cron "11 2 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/ithome/ithome.js, timeout=300, tag=IT之家签到, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/ithome.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=IT之家去抓取, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/ithome.png, argument="title=IT之家&url=&hint=打开「IT之家」停留几秒即自动抓取", enable={capture}
