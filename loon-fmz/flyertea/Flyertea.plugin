#!name=飞客茶馆每日签到
#!desc=飞客茶馆每日签到；用法：装好插件，打开重写和 cron，打开「飞客茶馆」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:02 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/flyert.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：chavyleung/scripts（flyertea.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = www.flyertea.com

[Script]
http-request ^https?://www\.flyertea\.com/source/plugin/mobile/mobile\.php\?module=getdata& script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/flyertea/flyertea_capture.js, requires-body=false, tag=飞客茶馆每日签到 Cookie, argument="key=chavy_cookie_flyertea&title=飞客茶馆", enable={capture}
cron "2 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/flyertea/flyertea.js, timeout=300, tag=飞客茶馆每日签到, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/flyert.png, enable=true
