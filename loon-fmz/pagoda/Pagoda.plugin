#!name=百果园每日签到
#!desc=百果园每日签到；用法：装好插件，打开重写和 cron，打开「百果园小程序」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 02:11 自动签到。\n手动抓取：点 Loon 脚本里的「百果园去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = wx-mini.pagoda.com.cn

[Script]
http-request ^https?://wx-mini\.pagoda\.com\.cn/api/v1/wxmini/signIn/customer script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/pagoda/pagoda_capture.js, requires-body=false, tag=百果园 Cookie, argument="title=百果园", enable={capture}
cron "11 2 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/pagoda/pagoda.js, timeout=300, tag=百果园签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=百果园去抓取, argument="title=百果园&url=&hint=打开「百果园小程序」停留几秒即自动抓取", enable={capture}
