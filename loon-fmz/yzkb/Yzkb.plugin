#!name=柚子快报每日签到
#!desc=柚子快报每日签到；用法：装好插件，打开重写和 cron，打开「柚子快报」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 00:11 自动签到。\n手动抓取：点 Loon 脚本里的「柚子快报去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = hongbao.youzikuaibao.com

[Script]
http-request ^https?://hongbao\.youzikuaibao\.com/youzi/change/youzi\.php script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/yzkb/yzkb_capture.js, requires-body=true, tag=柚子快报 Cookie, argument="title=柚子快报", enable={capture}
cron "11 0 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/yzkb/yzkbSign.js, timeout=300, tag=柚子快报签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=柚子快报去抓取, argument="title=柚子快报&url=&hint=打开「柚子快报」停留几秒即自动抓取", enable={capture}
