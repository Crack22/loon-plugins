#!name=蔚来每日签到
#!desc=蔚来每日签到；用法：装好插件，打开重写和 cron，打开「蔚来」App 手动签到一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:07 自动签到。\n手动抓取：点 Loon 脚本里的「蔚来去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = app.nio.com

[Script]
http-request ^https://app\.nio\.com/api/1/app/daily_checkin script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/nio/nio_capture.js, requires-body=false, tag=蔚来 Cookie, argument="title=蔚来", enable={capture}
cron "7 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/nio/nio.js, timeout=300, tag=蔚来签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=蔚来去抓取, argument="title=蔚来&url=&hint=打开「蔚来」App 手动签到一次即自动抓取", enable={capture}
