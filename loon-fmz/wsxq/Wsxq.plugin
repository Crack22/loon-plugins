#!name=微商星球每日签到
#!desc=微商星球每日签到；用法：装好插件，打开重写和 cron，打开「微商星球」停留几秒，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 00:16 自动签到。\n手动抓取：点 Loon 脚本里的「微商星球去抓取」，按弹出的提示操作。
#!author=許諾
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = api.momosyb.com

[Script]
http-request ^https?://api\.momosyb\.com/(v6|v1)/(fans|user)/ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/wsxq/wsxq_capture.js, requires-body=true, tag=微商星球 Cookie, argument="title=微商星球", enable={capture}
cron "16 0 * * *" script-path=https://raw.githubusercontent.com/XidNDD/2020scripts/master/wsxqSign.js, timeout=300, tag=微商星球签到, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=微商星球去抓取, argument="title=微商星球&url=&hint=打开「微商星球」停留几秒即自动抓取", enable={capture}
