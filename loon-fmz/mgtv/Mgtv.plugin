#!name=芒果TV每日签到
#!desc=芒果TV每日签到；用法：装好插件，打开重写和 cron，打开「芒果TV」App 手动签到一次，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:04 自动签到。\n手动抓取：点 Loon 脚本里的「芒果TV去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/mangguotv.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = credits.bz.mgtv.com

[Script]
http-request ^https://credits\.bz\.mgtv\.com/user/creditsTake script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/mgtv/mgtv_capture.js, requires-body=false, tag=芒果TV Cookie, argument="title=芒果TV", enable={capture}
cron "4 8 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/mgtv/mgtv.js, timeout=300, tag=芒果TV签到, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/mangguotv.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=芒果TV去抓取, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/mangguotv.png, argument="title=芒果TV&url=&hint=打开「芒果TV」App 手动签到一次即自动抓取", enable={capture}
