#!name=FlixPilot每日签到
#!desc=FlixPilot每日签到领爆米花：每天先查签到状态，没签就自动签到，签到结果会通知你（签到时间在 BoxJs 里设置，默认 09:00，也可以指定时间或在时间区间内随机）。\n两种登录方式二选一：①账号密码：在 BoxJs 里填用户名和密码，每天自动登录签到；②Cookie：打开本站一次自动抓取（只存账号1），或在 BoxJs 里粘贴 Cookie。两个都填优先账号密码。\n多账号：在 BoxJs「多账号」里每行一个 Cookie，或每行一个 用户名；密码。\n账号密码和 Cookie 只保存在你手机本地，不会上传。
#!author=許諾
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Category_Popcorn.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=Cookie抓取,desc=打开后，打开本站会自动抓取 Cookie；抓完可以关掉
manualRun = switch,false,tag=手动运行一次,desc=打开后运行一次，手动关闭

[Script]
cron "* * * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-flixpilot/flixpilot_checkin.js, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Category_Popcorn.png, tag=FlixPilot签到, enable=true
cron "* * * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-flixpilot/flixpilot_checkin.js, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Category_Popcorn.png, tag=手动运行一次, argument=[{manualRun}], enable={manualRun}
http-request ^https?://flixpilot\.wybcs\.work/api/ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-flixpilot/flixpilot_cookie.js, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Category_Popcorn.png, requires-body=false, tag=FlixPilot Cookie抓取, enable={capture}

[MITM]
hostname = flixpilot.wybcs.work
