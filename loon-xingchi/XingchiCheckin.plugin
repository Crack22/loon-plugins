#!name=星驰每日签到
#!desc=星驰API公益站每日签到领额度：每天先查签到状态，没签就自动领取，签到结果会通知你（签到时间在 BoxJs 里设置，默认 09:00，也可以指定时间或在时间区间内随机）。\n不用填账号密码：先在 Safari 打开 https://xingchiapi.com 登录一次（登录页有人机验证，脚本无法代替登录），Token 会自动抓取保存到账号1，之后每天自动刷新 Token 签到；Token 过期时重新登录一次即可。\n多账号：在 BoxJs「多账号」里每行一个 refresh_token，行首加 名字| 可自定义通知里的名字。\nToken 只保存在你手机本地，不会上传。\n今天已签过到的话，手动运行一次会显示“今日已签到”，说明 Token 和签到都正常。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/xingchi.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=Token抓取,desc=打开后，在 Safari 打开本站登录时会自动抓取 Token；抓完可以关掉
manualRun = switch,false,tag=手动运行一次,desc=打开后运行一次，手动关闭

[Script]
cron "* * * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-xingchi/xingchi_checkin.js, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/xingchi.png, tag=星驰签到, enable=true
cron "* * * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-xingchi/xingchi_checkin.js, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/xingchi.png, tag=手动运行一次, argument=[{manualRun}], enable={manualRun}
http-response ^https://(api\.)?xingchiapi\.com/api/v1/auth/(login|refresh)$ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-xingchi/xingchi_token.js, requires-body=true, tag=星驰Token抓取, enable={capture}
http-response ^https://(api\.)?xingchiapi\.com/api/v1/auth/oauth/pending/exchange$ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-xingchi/xingchi_token.js, requires-body=true, tag=星驰Token抓取, enable={capture}
http-request ^https://(api\.)?xingchiapi\.com/api/v1/user/ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-xingchi/xingchi_token.js, requires-body=false, tag=星驰Token抓取, enable={capture}

[MITM]
hostname = xingchiapi.com, api.xingchiapi.com
