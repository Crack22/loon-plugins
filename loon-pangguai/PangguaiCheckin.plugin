#!name=胖乖商城每日签到
#!desc=胖乖商城每日签到领积分：每天先查签到状态，没签就自动签到，签到结果会通知你（签到时间在 BoxJs 里设置，默认 09:00，也可以指定时间或在时间区间内随机）。\nCookie 抓取：打开签到页 https://shop104224478.youzan.com/wscump/checkin/result?shopAutoEnter=1&kdtId=104032310 一次自动抓取（只存账号1），或在 BoxJs 里粘贴完整 Cookie。登录有滑块验证，脚本不做账号密码登录。\n多账号：在 BoxJs「多账号」里每行一个完整 Cookie。\nCookie 只保存在你手机本地，不会上传。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/pangguai.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=Cookie抓取,desc=打开后，打开签到页会自动抓取 Cookie；抓完可以关掉
manualRun = switch,false,tag=手动运行一次,desc=打开后运行一次，手动关闭

[Script]
cron "* * * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-pangguai/pangguai_checkin.js, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/pangguai.png, tag=胖乖商城签到, enable=true
cron "* * * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-pangguai/pangguai_checkin.js, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/pangguai.png, tag=手动运行一次, argument=[{manualRun}], enable={manualRun}
http-request ^https?://shop104224478\.youzan\.com/wscump/checkin/ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-pangguai/pangguai_cookie.js, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/pangguai.png, requires-body=false, tag=胖乖商城 Cookie抓取, enable={capture}

[MITM]
hostname = shop104224478.youzan.com
