{
  "id": "xunuo.leguan.sub",
  "name": "乐观专用",
  "author": "許諾",
  "icon": "https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/leguan.jpg",
  "repo": "https://github.com/Crack22/loon-plugins",
  "apps": [
    {
      "id": "embypulse_dijia_checkin",
      "name": "乐观每日签到",
      "keys": [
        "embypulse2_session_id",
        "embypulse2_username",
        "embypulse2_password",
        "embypulse2_accounts",
        "embypulse2_max_accounts"
      ],
      "author": "許諾",
      "repo": "https://github.com/Crack22/loon-plugins",
      "script": "https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-embypulse2/embypulse_dijia_checkin.js",
      "settings": [
        {
          "id": "embypulse2_session_id",
          "name": "账号1 session_id",
          "val": "",
          "type": "textarea",
          "desc": "账号1 的 session_id：打开 https://embyyh.dijia.de/ 自动抓取，或手动粘贴。也可以只填账号密码登录，不用填 session_id"
        },
        {
          "id": "embypulse2_username",
          "name": "账号1 账号",
          "val": "",
          "type": "text",
          "desc": "乐观账号（和 session_id 二选一）"
        },
        {
          "id": "embypulse2_password",
          "name": "账号1 密码",
          "val": "",
          "type": "password",
          "desc": "乐观密码"
        },
        {
          "id": "embypulse2_accounts",
          "name": "多账号",
          "val": "",
          "type": "textarea",
          "desc": "每行一个账号：填 session_id，或 账号----密码（四个短横线隔开），不限个数"
        },
        {
          "id": "embypulse2_max_accounts",
          "name": "登录账号数量",
          "val": "",
          "type": "text",
          "desc": "填数字只签前 N 个账号，空着就是全部都签"
        }
      ],
      "icons": [
        "https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/leguan.jpg"
      ],
      "descs_html": [
        "乐观每日签到，每天 09:00 自动签到，奖励 90-130 积分。",
        "Loon 插件：<a href=\"loon://import?plugin=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-embypulse2/EmbyPulseDijiaCheckin.plugin\">点击安装 Loon 插件</a>",
        "不用挂梯子也能签：用「同步Git Secrets」把账号传到云上，GitHub Actions 每天 09:00 自动签。"
      ]
    }
  ]
}