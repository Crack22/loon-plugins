#!name=同步Git Secrets
#!desc=把 BoxJs 里的签到账号上传到 GitHub 仓库 Secrets，GitHub Actions 每天 09:00 自动签到，不用挂梯子；本地 Loon 插件保持不变。平时在 Loon 里点这个脚本手动运行一次，就会上传
#!author=許諾
#!icon=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/gh-secrets.jpg

[Script]
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-gh-sync/github_secrets_sync.js, requires-body=false, tag=同步Git Secrets, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/gh-secrets.jpg, enabled=true
