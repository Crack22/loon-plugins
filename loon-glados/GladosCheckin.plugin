#!name=GLaDOS 每日签到
#!desc=GLaDOS 每日签到，每天 09:00 自动签到领积分；用法：开重写，打开 https://glados.rocks/console/account 停 1 秒，收到 Cookie 获取成功即抓取成功，cron 每天 09:00 自动签到。\n注意：GLaDOS 会校验抓包时的设备，抓包和签到必须用同一台设备（建议都在手机上），换设备登录后要重新抓 Cookie。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/glados.png
#!tag=GLaDOS
#!system=ios

# 用法：
# 1、安装插件，开启重写脚本 + cron
# 2、打开 https://glados.rocks/console/account 停留 1 秒
# 3、收到 ✅ GLaDOS Cookie 获取成功 通知即抓取成功
# 4、cron 每天 09:00 自动签到
[MITM]
hostname = glados.rocks

[Script]
http-request ^https:\/\/glados\.rocks\/console\/account$ tag=GLaDOS Cookie, script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-glados/glados_cookie.js, requires-body=false, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/glados.png
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-glados/glados_checkin.js, tag=GLaDOS签到, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/glados.png, enable=true
