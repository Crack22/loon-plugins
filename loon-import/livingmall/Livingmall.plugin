#!name=丽影云街每日签到
#!desc=丽影云街每日签到；用法：装好插件，打开重写和 cron，打开丽影云街微信小程序，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 7:17 自动签到。\n手动抓取：点 Loon 脚本里的「丽影云街去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/FoKit/Scripts/main/images/livingmall.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：FoKit/Scripts（livingmall.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = rest.zhimatech.com

[Script]
http-request ^https://rest\.zhimatech\.com/v3/api script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/livingmall/livingmall_capture.js, requires-body=true, tag=丽影云街每日签到抓取, enable={capture}
cron "17 7 * * *" script-path=https://raw.githubusercontent.com/FoKit/Scripts/main/scripts/livingmall.js, timeout=300, tag=丽影云街每日签到, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/livingmall.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=丽影云街去抓取, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/livingmall.png, argument="title=丽影云街&url=&hint=打开丽影云街微信小程序", enable={capture}
