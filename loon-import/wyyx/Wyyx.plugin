#!name=网易严选兑换
#!desc=网易严选积分兑换：每天 0:45、11:45、21:45 自动兑换指定商品；商品名称填好才会兑换（先运行一次查看可兑换商品名），兑换账号默认第 1 个。
#!author=許諾
#!icon=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/WYYX/WYYX.png
#!homepage=https://github.com/Crack22/loon-plugins


[Script]
cron "45 0,11,21 * * *" script-path=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/WYYX/WYYX_Exchange.js, timeout=300, tag=网易严选兑换, img-url=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/WYYX/WYYX.png, enable=true
