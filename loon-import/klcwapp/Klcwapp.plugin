#!name=酷乐潮玩App每日签到
#!desc=酷乐潮玩App每日签到；用法：装好插件，打开重写和 cron，打开酷乐潮玩 App，点一次签到，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 0:05 自动签到。\n手动抓取：点 Loon 脚本里的「酷乐潮玩App去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/picture/klcw_tran.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = app.klcw.net.cn

[Script]
http-request ^https://app\.klcw\.net\.cn/omp_cmanage/mallgateway script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/klcwapp/klcwapp_capture.js, requires-body=true, tag=酷乐潮玩App每日签到抓取, enable={capture}
cron "5 0 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/klcwapp/klcw-app.js, timeout=300, tag=酷乐潮玩App每日签到, img-url=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/picture/klcw_tran.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=酷乐潮玩App去抓取, img-url=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/picture/klcw_tran.png, argument="title=酷乐潮玩App&url=&hint=打开酷乐潮玩 App，点一次签到", enable={capture}
