#!name=华住会每日签到
#!desc=华住会每日签到；用法：装好插件，打开重写和 cron，打开华住会 App，点一次签到，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 0:05 自动签到。\n手动抓取：点 Loon 脚本里的「华住会去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/picture/hzh_tran.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = hweb-mbf.huazhu.com

[Script]
http-request ^https://hweb-mbf\.huazhu\.com/api/signIn script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/hzh/hzh_capture.js, requires-body=false, tag=华住会每日签到抓取, enable={capture}
cron "5 0 * * *" script-path=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/check_in/hzh/hzh.js, timeout=300, tag=华住会每日签到, img-url=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/picture/hzh_tran.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=华住会去抓取, img-url=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/picture/hzh_tran.png, argument="title=华住会&url=&hint=打开华住会 App，点一次签到", enable={capture}
