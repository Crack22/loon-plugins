#!name=捷停车每日签到
#!desc=捷停车每日签到；用法：装好插件，打开重写和 cron，打开捷停车 App，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 9:15 自动签到。\n手动抓取：点 Loon 脚本里的「捷停车去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/FoKit/Scripts/main/images/jparking.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = sytgate.jslife.com.cn

[Script]
http-request ^https://sytgate\.jslife\.com\.cn/core-gateway/order/carno/pay/info script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/jparking/jparking_capture.js, requires-body=true, tag=捷停车每日签到抓取, enable={capture}
cron "15 9 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/jparking/jparking_sign.js, timeout=300, tag=捷停车每日签到, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/jparking.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=捷停车去抓取, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/jparking.png, argument="title=捷停车&url=&hint=打开捷停车 App", enable={capture}
