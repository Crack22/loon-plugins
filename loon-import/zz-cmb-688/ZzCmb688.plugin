#!name=招商银行 - 688、188每日签到
#!desc=招商银行 - 688、188每日签到；用法：装好插件，打开 cron，无需填 Cookie，到点按通知跳转手动完成即可；cron 每天 08:15 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Orz-3/mini/master/Alpha/cmbchina.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：zZPiglet/Task（CMB_688.js）
[Script]
cron "15 8 * * *" script-path=https://raw.githubusercontent.com/zZPiglet/Task/master/CMB/CMB_688.js, timeout=300, tag=招商银行 - 688、188每日签到, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Alpha/cmbchina.png, enable=true
