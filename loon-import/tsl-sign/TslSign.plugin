#!name=谢瑞麟 TSL每日签到
#!desc=谢瑞麟 TSL每日签到；用法：装好插件，打开重写和 cron，打开谢瑞麟微信小程序并登录，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 7:17 自动签到。\n手动抓取：点 Loon 脚本里的「谢瑞麟 TSL去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/FoKit/Scripts/main/images/tsl.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：FoKit/Scripts（tsl_sign.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = tslmember-crm.tslj.com.cn

[Script]
http-response ^https://tslmember-crm\.tslj\.com\.cn/api/auth/login script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/tsl-sign/tsl_sign_capture.js, requires-body=true, tag=谢瑞麟 TSL每日签到抓取, enable={capture}
cron "17 7 * * *" script-path=https://raw.githubusercontent.com/FoKit/Scripts/main/scripts/tsl_sign.js, timeout=300, tag=谢瑞麟 TSL每日签到, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/tsl.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=谢瑞麟 TSL去抓取, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/tsl.png, argument="title=谢瑞麟 TSL&url=&hint=打开谢瑞麟微信小程序并登录", enable={capture}
