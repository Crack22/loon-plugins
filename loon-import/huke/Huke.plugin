#!name=虎课网每日签到
#!desc=虎课网每日签到；用法：装好插件，打开重写和 cron，打开虎课网 App，点签到页，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 09:00 自动签到。\n手动抓取：点 Loon 脚本里的「虎课网去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Former-Years/icon/master/huke.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：Former-Years/Surge（huke.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = api.huke88.com

[Script]
http-request ^https://api\.huke88\.com/v5/activity/sign script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/huke/huke_capture.js, requires-body=false, tag=虎课网每日签到 Cookie, argument="title=虎课网", enable={capture}
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/Former-Years/Surge/main/Script/huke.js, timeout=300, tag=虎课网每日签到, img-url=https://raw.githubusercontent.com/Former-Years/icon/master/huke.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=虎课网去抓取, img-url=https://raw.githubusercontent.com/Former-Years/icon/master/huke.png, argument="title=虎课网&url=&hint=打开虎课网 App，点签到页，收到通知即抓取成功", enable={capture}
