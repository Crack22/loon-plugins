#!name=hifini签到
#!desc=hifini签到；用法：装好插件，打开重写和 cron，用 Safari 打开 https://www.hifini.com/my.htm 并登录，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 10:00 自动签到。\n手动抓取：点 Loon 脚本里的「hifini去抓取」，点弹出的通知即打开抓取页。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lowking/Scripts/master/doc/icon/hifinisignin.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = www.hifini.com

[Script]
http-request ^https?://www\.hifini\.com/my\.htm script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=hifini签到 Cookie, argument="key=lkHifiniCookieKey&source=cookie&title=hifini", enable={capture}
cron "0 10 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/lkhifinisignin/hifiniSign.js, timeout=300, tag=hifini签到, img-url=https://raw.githubusercontent.com/lowking/Scripts/master/doc/icon/hifinisignin.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=hifini去抓取, img-url=https://raw.githubusercontent.com/lowking/Scripts/master/doc/icon/hifinisignin.png, argument="title=hifini&url=https%3A%2F%2Fwww.hifini.com%2Fmy.htm&hint=在 Safari 里登录 hifini，停留几秒即自动抓取", enable={capture}
