#!name=鸿星尔克每日签到
#!desc=鸿星尔克每日签到；用法：装好插件，打开重写和 cron，微信打开鸿星尔克小程序，点会员中心，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 09:15 自动签到。\n手动抓取：点 Loon 脚本里的「鸿星尔克去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Former-Years/icon/master/erke.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = hope.demogic.com

[Script]
http-request ^https://hope\.demogic\.com/gic-wx-app/get-member-asset\.json script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/erke/erke_capture.js, requires-body=false, tag=鸿星尔克每日签到 Cookie, argument="title=鸿星尔克", enable={capture}
cron "15 9 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/erke/erke.js, timeout=300, tag=鸿星尔克每日签到, img-url=https://raw.githubusercontent.com/Former-Years/icon/master/erke.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=鸿星尔克去抓取, img-url=https://raw.githubusercontent.com/Former-Years/icon/master/erke.png, argument="title=鸿星尔克&url=&hint=微信打开鸿星尔克小程序，点会员中心，收到通知即抓取成功", enable={capture}
