#!name=彩云天气
#!desc=彩云天气推送：自动定位、异常天气预警、实时天气预报，每 2 小时（8:00-22:00）推送一次。需要免费申请彩云天气 API Token 填入 BoxJs；定位通过打开系统天气 App 自动获取（需先打开「抓取开关」），也可手动填经纬度。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/caiyuntianqi.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：Peng-YM/QuanX（caiyun.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开对应 App/小程序会自动保存要用的数据；抓完可以关掉

[MITM]
hostname = weather-data.apple.com, api.weather.com

[Script]
http-request https://((weather-data\.apple)|(api.weather))\.com script-path=https://raw.githubusercontent.com/Peng-YM/QuanX/master/Tasks/caiyun.js, requires-body=false, tag=彩云天气定位, enable={capture}
cron "10 8-22/2 * * *" script-path=https://raw.githubusercontent.com/Peng-YM/QuanX/master/Tasks/caiyun.js, timeout=300, tag=彩云天气, img-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/caiyuntianqi.png, enable=true
