#!name=绝区零每日签到
#!desc=绝区零每日签到；用法：装好插件，打开 cron，在 BoxJs 里填好 Uid 和米游社 Cookie 等；cron 每天 10:00 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lowking/Scripts/master/doc/icon/zzz.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：lowking/Scripts（zzz.js）
[Script]
cron "0 10 * * *" script-path=https://raw.githubusercontent.com/lowking/Scripts/master/mihoyo/zzz.js, timeout=700, tag=绝区零每日签到, img-url=https://raw.githubusercontent.com/lowking/Scripts/master/doc/icon/zzz.png, enable=true
