#!name=九木杂物社每日签到
#!desc=九木杂物社每日签到；用法：装好插件，打开重写和 cron，在微信里打开九木杂物社小程序，点一次签到，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 0:05 自动签到。\n手动抓取：点 Loon 脚本里的「九木杂物社去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/picture/jiumu_tran.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = wxavip-up.ezrpro.cn

[Script]
http-request ^https://wxavip-up\.ezrpro\.cn/Vip/SignIn/SignIn script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/jiumu/jiumu_capture.js, requires-body=true, tag=九木杂物社每日签到抓取, enable={capture}
cron "5 0 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/jiumu/jiumu.js, timeout=300, tag=九木杂物社每日签到, img-url=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/picture/jiumu_tran.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=九木杂物社去抓取, img-url=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/picture/jiumu_tran.png, argument="title=九木杂物社&url=&hint=在微信里打开九木杂物社小程序，点一次签到", enable={capture}
