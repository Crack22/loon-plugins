#!name=富连e充兑换
#!desc=富连e充积分兑换：每天 0:10 和 23:10 按设置的兑换次数自动兑换；兑换次数默认为 0（不兑换），填好次数才会兑换。
#!author=許諾
#!icon=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/YongXin/YongXin.jpg
#!homepage=https://github.com/Crack22/loon-plugins


[Script]
cron "10 0,23 * * *" script-path=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/YongXin/YongXin.js, timeout=300, tag=富连e充兑换, img-url=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/YongXin/YongXin.jpg, enable=true
