#!name=TestFlight账户管理
#!desc=TestFlight 多账号缓存清理工具；在 Loon「脚本」列表里点「清除缓存」手动运行一次，即清理 TestFlight 账号列表缓存并通知；无需填写任何配置。
#!author=許諾
#!icon=https://raw.githubusercontent.com/NobyDa/mini/master/Color/testflight.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：NobyDa/Script（TestFlightAccountRemoveCache.js）

[Script]
cron "0 0 29 2 *" script-path=https://gist.githubusercontent.com/NobyDa/d025c53d3922657f921b983ce129fc1d/raw/TestFlightAccountRemoveCache.js, timeout=300, tag=清除缓存, img-url=https://raw.githubusercontent.com/NobyDa/mini/master/Color/testflight.png, enable=true
