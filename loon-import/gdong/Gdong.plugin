#!name=G动每日签到
#!desc=G动每日签到；用法：装好插件，打开重写和 cron，打开 G动 App，点底部「锻炼」和「我的」，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 7:10 自动签到。\n手动抓取：点 Loon 脚本里的「G动去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/WowYiJiu/Personal/main/icon/Alpha/gdong.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = gdongapi.wo-ish.com

[Script]
http-request ^https://gdongapi\.wo-ish\.com/user/getUInfo script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/gdong/gdong_capture.js, requires-body=false, tag=G动每日签到抓取, enable={capture}
http-request ^https://gdongapi\.wo-ish\.com/MsgBoard/ShupUpV5 script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/gdong/gdong_capture.js, requires-body=true, tag=G动每日签到抓取, enable={capture}
cron "10 7 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/gdong/gdong.js, timeout=300, tag=G动每日签到, img-url=https://raw.githubusercontent.com/WowYiJiu/Personal/main/icon/Alpha/gdong.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=G动去抓取, img-url=https://raw.githubusercontent.com/WowYiJiu/Personal/main/icon/Alpha/gdong.png, argument="title=G动&url=&hint=打开 G动 App，点底部「锻炼」和「我的」", enable={capture}
