#!name=热搜聚合
#!desc=各平台热搜聚合推送：每天 6:00–23:00 每半小时推送一次热搜；在 BoxJs 里可自选平台和通知条数。
#!author=許諾
#!icon=https://is3-ssl.mzstatic.com/image/thumb/Purple126/v4/9a/d8/77/9ad877c6-e3d7-61a1-3911-5036239a41a6/AppIcon-1x_U007emarketing-0-7-0-0-sRGB-85-220.png/144x144bb.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：Yuheng0101/X（top.js）

[Script]
cron "30 6-23 * * *" script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Tasks/top.js, timeout=300, tag=热搜聚合, img-url=https://is3-ssl.mzstatic.com/image/thumb/Purple126/v4/9a/d8/77/9ad877c6-e3d7-61a1-3911-5036239a41a6/AppIcon-1x_U007emarketing-0-7-0-0-sRGB-85-220.png/144x144bb.png, enable=true
