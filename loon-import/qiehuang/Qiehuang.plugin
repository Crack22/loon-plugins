#!name=茄皇兑换
#!desc=茄皇兑换：每天 9:45 自动用积分兑换配置的商品。需要在 BoxJs 填写账号数据、商品 id，以及自建 OCR 服务地址（用于验证码识别）；账号需已有积分。脚本头 cron（7 7 7 7 7）为占位写法（7 月 7 日且星期 7 无效），已改为默认 9 点档。
#!author=許諾
#!icon=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/TongYi/QieHuang.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：xzxxn777/Surge（QieHuang_Exchange.js）
[Script]
cron "45 9 * * *" script-path=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/TongYi/QieHuang_Exchange.js, timeout=300, tag=茄皇兑换, img-url=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/TongYi/QieHuang.png, enable=true
