#!name=PP 停车每日签到
#!desc=PP 停车每日签到；用法：装好插件，打开重写和 cron，打开 PP 停车 App，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 7:17 自动签到。\n手动抓取：点 Loon 脚本里的「PP 停车去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/FoKit/Scripts/main/images/pp_parking.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = api.660pp.com

[Script]
http-request ^https://api\.660pp\.com/rest/[\d.]+?/user/token script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/pp-parking/pp_parking_capture.js, requires-body=false, tag=PP 停车每日签到抓取, enable={capture}
cron "17 7 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/pp-parking/pp_parking.js, timeout=300, tag=PP 停车每日签到, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/pp_parking.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=PP 停车去抓取, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/pp_parking.png, argument="title=PP 停车&url=&hint=打开 PP 停车 App", enable={capture}
