#!name=Telegram 频道媒体推送
#!desc=定时读取你关注的 Telegram 频道新图片/视频并推送通知；在 BoxJs 里填频道名（频道链接 https://t.me/s/ABCD 就填 ABCD）和每个频道最多推送的数量；每天 9:00 运行。
#!author=許諾
#!icon=https://raw.githubusercontent.com/58xinian/icon/master/telegram.png
#!homepage=https://github.com/Crack22/loon-plugins


[Script]
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/Peng-YM/QuanX/master/Tasks/telegram.js, timeout=300, tag=Telegram 频道媒体推送, img-url=https://raw.githubusercontent.com/58xinian/icon/master/telegram.png, enable=true
