#!name=无忧行每日签到
#!desc=无忧行每日签到；用法：装好插件，打开重写和 cron，打开无忧行 App，点签到页，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:24 自动签到。\n手动抓取：点 Loon 脚本里的「无忧行去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/id77/QuantumultX/master/icon/wyx.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = app.jegotrip.com.cn

[Script]
http-response ^https://app\.jegotrip\.com\.cn/api/service/v1/mission/sign/querySign\?token= script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/id77-jegotrip/jegotrip.cookie.js, requires-body=true, tag=无忧行 Token, enable={capture}
cron "24 8 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/id77-jegotrip/jegotrip.js, timeout=300, tag=无忧行每日签到, img-url=https://raw.githubusercontent.com/id77/QuantumultX/master/icon/wyx.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=无忧行去抓取, img-url=https://raw.githubusercontent.com/id77/QuantumultX/master/icon/wyx.png, argument="title=无忧行&url=&hint=打开无忧行 App 签到页，收到通知即抓取成功", enable={capture}
