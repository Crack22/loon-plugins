#!name=中兴每日签到
#!desc=中兴每日签到；用法：装好插件，打开 cron，在 BoxJs 里填好手机号&密码；cron 每天 01:33、19:33 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/ZTE/ZTE.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：xzxxn777/Surge（ZTE.js）
[Script]
cron "33 1,19 * * *" script-path=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/ZTE/ZTE.js, timeout=300, tag=中兴每日签到, img-url=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/ZTE/ZTE.png, enable=true
