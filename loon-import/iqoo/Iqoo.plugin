#!name=IQOO社区兑换
#!desc=iQOO 社区积分兑换：每天 9:20 用账号积分兑换指定商品；需要在 BoxJs 里填账号数据和商品 ID（商品 ID 为 0 时只查看可兑换商品、不兑换）；兑换账号默认第 1 个。脚本头注释里的定时是占位值（7 月 7 日一年一次），已改为每天 9:20。
#!author=許諾
#!icon=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/IQOO/IQOO.jpg
#!homepage=https://github.com/Crack22/loon-plugins


[Script]
cron "20 9 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/iqoo/IQOO_Exchange.js, timeout=300, tag=IQOO社区兑换, img-url=https://raw.githubusercontent.com/xzxxn777/Surge/main/Script/IQOO/IQOO.jpg, enable=true
