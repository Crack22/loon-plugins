#!name=米游社App自定义
#!desc=米游社 App 界面自定义：按 BoxJs 里的设置过滤「我的游戏」卡片、绝区零首页顶栏和 Tab、兑换中心商品，过滤咖啡馆置顶帖；打开米游社 App 即生效，需开启重写和 MITM。
#!author=許諾
#!icon=https://raw.githubusercontent.com/lowking/Scripts/master/doc/icon/miyoushe.png
#!homepage=https://github.com/Crack22/loon-plugins


[MITM]
hostname = api-takumi-record.mihoyo.com, bbs-api.miyoushe.com

[Script]
http-response https://\/\/api-takumi-record.mihoyo.com\/game_record\/card\/api\/getGameRecordCard script-path=https://raw.githubusercontent.com/lowking/Scripts/master/mihoyo/miyousheCustom.js, requires-body=true, tag=米游社App自定义
http-response https://\/\/bbs-api.miyoushe.com\/apihub\/api\/home\/new script-path=https://raw.githubusercontent.com/lowking/Scripts/master/mihoyo/miyousheCustom.js, requires-body=true, tag=米游社App自定义
http-response https://\/\/bbs-api.miyoushe.com\/forum\/api\/getDiscussionByGame\?gids=8 script-path=https://raw.githubusercontent.com/lowking/Scripts/master/mihoyo/miyousheCustom.js, requires-body=true, tag=米游社App自定义
http-response https://\/\/bbs-api.miyoushe.com\/common\/homushop\/v1\/web\/goods\/list script-path=https://raw.githubusercontent.com/lowking/Scripts/master/mihoyo/miyousheCustom.js, requires-body=true, tag=米游社App自定义
http-response https://\/\/bbs-api.miyoushe.com\/apihub\/api\/forumMain script-path=https://raw.githubusercontent.com/lowking/Scripts/master/mihoyo/miyousheCustom.js, requires-body=true, tag=米游社App自定义
