#!name=蜜雪冰城每日签到
#!desc=蜜雪冰城每日签到；用法：打开蜜雪冰城小程序，进入「我的」页面自动抓取 Access-Token，抓完后在设置里关掉「抓取开关」；cron 每天 08:22 自动签到。\n手动抓取：点 Loon 脚本里的「蜜雪冰城去抓取」查看抓取提示。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/mxbc.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 或小程序会自动保存签到要用的凭证；抓完可以关掉

[MITM]
hostname = mxsa.mxbc.net

[Script]
http-response ^https:\/\/mxsa\.mxbc\.net\/api\/v1\/customer\/info script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/sliverkiss-mxbc/sliverkiss-mxbc_capture.js, requires-body=true, tag=蜜雪冰城每日签到 Cookie, enable={capture}
cron "22 8 * * *" script-path=https://gist.githubusercontent.com/Sliverkiss/865c82e42a5730bb696f6700ebb94cee/raw/mxbc.js, timeout=300, tag=蜜雪冰城每日签到, img-url=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/mxbc.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=蜜雪冰城去抓取, img-url=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/mxbc.png, argument="title=蜜雪冰城&url=&hint=打开蜜雪冰城小程序，进入「我的」页面即自动抓取", enable={capture}
