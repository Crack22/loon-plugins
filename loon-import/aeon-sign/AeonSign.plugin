#!name=永旺 Aeon每日签到
#!desc=永旺 Aeon每日签到；用法：装好插件，打开重写和 cron，打开永旺 Aeon 微信小程序并登录，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 8:20 自动签到。\n手动抓取：点 Loon 脚本里的「永旺 Aeon去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/FoKit/Scripts/main/images/aeon.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = api.aeonbuy.com

[Script]
http-response ^https://api\.aeonbuy\.com/api/access-auth-api/auth/third/silentWechatMiniLogin script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/aeon-sign/aeon_sign_capture.js, requires-body=true, tag=永旺 Aeon每日签到抓取, enable={capture}
cron "20 8 * * *" script-path=https://raw.githubusercontent.com/FoKit/Scripts/main/scripts/aeon_sign.js, timeout=300, tag=永旺 Aeon每日签到, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/aeon.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=永旺 Aeon去抓取, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/aeon.png, argument="title=永旺 Aeon&url=&hint=打开永旺 Aeon 微信小程序并登录", enable={capture}
