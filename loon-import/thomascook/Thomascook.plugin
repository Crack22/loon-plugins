#!name=托迈酷客每日签到
#!desc=托迈酷客每日签到；用法：装好插件，打开重写和 cron，打开托迈酷客 App 或小程序，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 10:15 自动签到。\n手动抓取：点 Loon 脚本里的「托迈酷客去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/FoKit/Scripts/main/images/ThomasCook.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：FoKit/Scripts（ThomasCook.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = apis.folidaymall.com

[Script]
http-request ^https://apis\.folidaymall\.com/online/capi/uc/getCount script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=托迈酷客每日签到抓取, argument="key=ThomasCook_Cookie&source=authorization&title=托迈酷客每日签到", enable={capture}
cron "15 10 * * *" script-path=https://raw.githubusercontent.com/FoKit/Scripts/main/scripts/ThomasCook.js, timeout=300, tag=托迈酷客每日签到, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/ThomasCook.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=托迈酷客去抓取, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/ThomasCook.png, argument="title=托迈酷客&url=&hint=打开托迈酷客 App 或小程序", enable={capture}
