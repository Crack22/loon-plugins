#!name=学掌门打卡
#!desc=学掌门打卡；用法：装好插件，打开重写和 cron，打开学掌门 App，浏览课程/打卡相关页面，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:33 自动签到。\n手动抓取：点 Loon 脚本里的「学掌门去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Former-Years/icon/master/atstudy.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = www.atstudy.com

[Script]
http-request ^https://www\.atstudy\.com/.*summary script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/atstudydk/atstudydk_capture.js, requires-body=false, tag=学掌门打卡 Cookie, argument="title=学掌门", enable={capture}
cron "33 8 * * *" script-path=https://raw.githubusercontent.com/Former-Years/Surge/main/Script/daka.js, timeout=300, tag=学掌门打卡, img-url=https://raw.githubusercontent.com/Former-Years/icon/master/atstudy.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=学掌门去抓取, img-url=https://raw.githubusercontent.com/Former-Years/icon/master/atstudy.png, argument="title=学掌门&url=&hint=打开学掌门 App，浏览课程/打卡相关页面，收到通知即抓取成功", enable={capture}
