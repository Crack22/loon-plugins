#!name=中免会员每日签到
#!desc=中免会员每日签到；用法：打开中免会员小程序，进入「我的」→「积分明细」自动抓取 x-access-token，抓完后在设置里关掉「抓取开关」；cron 每天 00:03 自动签到。\n手动抓取：点 Loon 脚本里的「中免会员去抓取」查看抓取提示。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/Zmhy.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：Sliverkiss（gist zmhy.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 或小程序会自动保存签到要用的凭证；抓完可以关掉

[MITM]
hostname = cdfmbrapi.cdfg.com.cn

[Script]
http-request ^https:\/\/cdfmbrapi\.cdfg\.com\.cn\/api\/points\/paymentList script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/sliverkiss-zmhy/sliverkiss-zmhy_capture.js, tag=中免会员每日签到 Cookie, enable={capture}
cron "3 0 * * *" script-path=https://gist.githubusercontent.com/Sliverkiss/7f16bab92e312d1f0e520ca20d389924/raw/29b180093d17edd6ccf0a6fdce14a8d9ec7b06df/zmhy.js, timeout=300, tag=中免会员每日签到, img-url=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/Zmhy.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=中免会员去抓取, img-url=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/Zmhy.png, argument="title=中免会员&url=&hint=打开中免会员小程序，进入「我的」→「积分明细」即自动抓取", enable={capture}
