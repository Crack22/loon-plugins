#!name=支付宝 - 积分能量每日签到
#!desc=支付宝 - 积分能量每日签到；用法：装好插件，打开 cron，无需填 Cookie，到点按通知跳转手动完成即可；cron 每天 07:25 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Orz-3/mini/master/Alpha/alipay.png
#!homepage=https://github.com/Crack22/loon-plugins

[Script]
cron "25 7 * * *" script-path=https://raw.githubusercontent.com/zZPiglet/Task/master/Alipay/Alipay.js, timeout=300, tag=支付宝 - 积分能量每日签到, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Alpha/alipay.png, enable=true
