#!name=青碳行每日签到
#!desc=青碳行每日签到；用法：抓包 carbon.lcago.cn 请求体里的 token 和 deviceCoding，按 token&deviceCoding 格式粘贴到 BoxJs 的 qtxtk 里，多账号换行或 @ 分隔（旧的 qtx_data 已作废，需重新抓取）；cron 每天 05:09 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/qtx.png
#!homepage=https://github.com/Crack22/loon-plugins

[Script]
cron "9 5 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/sliverkiss-qtx/qtx.js, timeout=300, tag=青碳行每日签到, img-url=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/qtx.png, enable=true
