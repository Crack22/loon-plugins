#!name=Luka阅读养成每日签到
#!desc=Luka阅读养成每日签到；用法：装好插件，打开重写和 cron，打开 Luka App 浏览，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 08:57 自动签到。\n手动抓取：点 Loon 脚本里的「Luka去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/luka/luka.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：blackmatrix7/ios_rule_script（luka_signin.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = luka-graphql.ling.cn

[Script]
http-request ^https?://luka-graphql\.ling\.cn/graphql/mobile\?operation=UserInfoWithPendingRobotQuery script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/blackmatrix7-luka/blackmatrix7-luka_capture.js, requires-body=false, tag=Luka阅读养成每日签到 Cookie, argument="title=Luka", enable={capture}
cron "57 8 * * *" script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/luka/luka_signin.js, timeout=300, tag=Luka阅读养成每日签到, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/luka/luka.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=Luka去抓取, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/luka/luka.png, argument="title=Luka&url=&hint=打开 Luka App 浏览，收到通知即抓取成功", enable={capture}
