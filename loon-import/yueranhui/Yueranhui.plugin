#!name=悦然荟每日签到
#!desc=悦然荟每日签到；用法：装好插件，打开重写和 cron，打开悦然荟微信小程序，进入会员中心，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 7:17 自动签到。\n手动抓取：点 Loon 脚本里的「悦然荟去抓取」，按弹出的提示操作。\n注意：签到还需配置微信 Code Server（BoxJs 键 @codeServer.address），否则 cron 拿不到登录 code 无法签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/FoKit/Scripts/main/images/yrh.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = wox2019.woxshare.com

[Script]
http-request ^https?://wox2019\.woxshare\.com/clientApi/userCenterDetail script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/yueranhui/yueranhui_capture.js, requires-body=false, tag=悦然荟每日签到抓取, enable={capture}
cron "17 7 * * *" script-path=https://raw.githubusercontent.com/FoKit/Scripts/main/scripts/yueran_sign.js, timeout=300, tag=悦然荟每日签到, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/yrh.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=悦然荟去抓取, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/yrh.png, argument="title=悦然荟&url=&hint=打开悦然荟微信小程序，进入会员中心", enable={capture}
