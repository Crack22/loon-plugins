#!name=轻之文库每日签到
#!desc=轻之文库每日签到；用法：把账号和密码用 # 拼接（账号#密码）填到 BoxJs 的 linovel_data 里，多账号用 @ 分隔；cron 每天 02:15 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/Linovel.png
#!homepage=https://github.com/Crack22/loon-plugins

[Script]
cron "15 2 * * *" script-path=https://gist.githubusercontent.com/Sliverkiss/a56aaa31bbc01191590b9c4c5c698751/raw/linovel.js, timeout=300, tag=轻之文库每日签到, img-url=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/Linovel.png, enable=true
