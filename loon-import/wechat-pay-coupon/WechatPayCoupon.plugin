#!name=微信支付有优惠每日签到
#!desc=微信支付有优惠每日签到；用法：装好插件，打开重写和 cron，打开微信支付有优惠小程序，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 9:30 自动签到。\n手动抓取：点 Loon 脚本里的「微信支付有优惠去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/FoKit/Scripts/main/images/wechat_pay_coupon.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = payapp.weixin.qq.com

[Script]
http-response ^https://payapp\.weixin\.qq\.com/(coupon-center-user/home/login|coupon-center-award/award/detail) script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/wechat-pay-coupon/wechat_pay_coupon_capture.js, requires-body=true, tag=微信支付有优惠每日签到抓取, enable={capture}
cron "30 9 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/wechat-pay-coupon/wechat_pay_coupon.js, timeout=300, tag=微信支付有优惠每日签到, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/wechat_pay_coupon.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=微信支付有优惠去抓取, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/wechat_pay_coupon.png, argument="title=微信支付有优惠&url=&hint=打开微信支付有优惠小程序", enable={capture}
