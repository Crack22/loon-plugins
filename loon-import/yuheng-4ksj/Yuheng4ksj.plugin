#!name=4K世界自动签到
#!desc=4K世界自动签到；用法：装好插件，打开 cron，在 BoxJs 里填好登录账号和密码；cron 每天 06:00 自动签到。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Yuheng0101/X/main/Assets/4ksj.png
#!homepage=https://github.com/Crack22/loon-plugins

[Script]
cron "0 6 * * *" script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Tasks/4ksj.js, timeout=300, tag=4K世界自动签到, img-url=https://raw.githubusercontent.com/Yuheng0101/X/main/Assets/4ksj.png, enable=true
