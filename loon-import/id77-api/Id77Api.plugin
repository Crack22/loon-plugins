#!name=自用JDCookie管理
#!desc=自用京东 Cookie 同步管理：从自建同步接口拉取京东 Cookie 并写入本地，每天 9:15 同步一次。需要自备返回京东 Cookie 列表的接口地址（id77_api_sync_cookie）。脚本头无定时，原定时为默认 9 点档。
#!author=許諾
#!icon=https://raw.githubusercontent.com/id77/QuantumultX/master/icon/link.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：id77/QuantumultX（syncJDCookie.js）
[Script]
cron "15 9 * * *" script-path=https://raw.githubusercontent.com/id77/QuantumultX/master/Script/syncJDCookie.js, timeout=300, tag=自用JDCookie管理, img-url=https://raw.githubusercontent.com/id77/QuantumultX/master/icon/link.png, enable=true
