#!name=雨晨ios每日签到
#!desc=雨晨ios每日签到；用法：打开雨晨ios网站，登录后进入「我的」，随便点一个按钮（如编辑资料、积分管理）自动抓取 Cookie，抓完后在设置里关掉「抓取开关」；cron 每天 10:14 自动签到。\n手动抓取：点 Loon 脚本里的「雨晨ios去抓取」，点弹出的通知即打开抓取页。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/yuchenios.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：Sliverkiss/GoodNight（yuchenios.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 或小程序会自动保存签到要用的凭证；抓完可以关掉

[MITM]
hostname = yuchen.tonghuaios.com

[Script]
http-request ^https:\/\/yuchen\.tonghuaios\.com\/users\?.+ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=雨晨ios每日签到 Cookie, argument="key=yuchenCookie&source=cookie&title=雨晨ios每日签到", enable={capture}
cron "14 10 * * *" script-path=https://raw.githubusercontent.com/Sliverkiss/GoodNight/master/Script/yuchenios.js, timeout=300, tag=雨晨ios每日签到, img-url=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/yuchenios.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=雨晨ios去抓取, img-url=https://raw.githubusercontent.com/Sliverkiss/QuantumultX/main/icon/yuchenios.png, argument="title=雨晨ios&url=https%3A%2F%2Fyuchen.tonghuaios.com&hint=登录后进入「我的」，随便点一个按钮（如编辑资料、积分管理）即自动抓取", enable={capture}
