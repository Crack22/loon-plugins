#!name=花城汇每日签到
#!desc=花城汇每日签到；用法：装好插件，打开重写和 cron，打开花城汇微信小程序，进入会员页，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 7:17 自动签到。\n手动抓取：点 Loon 脚本里的「花城汇去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/FoKit/Scripts/main/images/hch.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = member.mowgz.com

[Script]
http-request ^https://member\.mowgz\.com/bus/getFunc\?busId=Member&methodId=getMember&getPram=gold%2Clevel&compId=\d+?&userId=\w+ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_checkin_capture.js, requires-body=false, tag=花城汇每日签到抓取, argument="key=@hch.userid&source=query:userId&title=花城汇每日签到", enable={capture}
cron "17 7 * * *" script-path=https://raw.githubusercontent.com/FoKit/Scripts/main/scripts/hch_sign.js, timeout=300, tag=花城汇每日签到, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/hch.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=花城汇去抓取, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/hch.png, argument="title=花城汇&url=&hint=打开花城汇微信小程序，进入会员页", enable={capture}
