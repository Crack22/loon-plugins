#!name=酷乐潮玩小程序每日签到
#!desc=酷乐潮玩小程序每日签到；用法：装好插件，打开重写和 cron，在微信里打开酷乐潮玩小程序，点一次签到，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 0:05 自动签到。\n手动抓取：点 Loon 脚本里的「酷乐潮玩小程序去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/picture/klcw_tran.png
#!homepage=https://github.com/Crack22/loon-plugins

# 脚本来源：evilbutcher/Quantumult_X（klcw.js）
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = wxavip-tp.ezrpro.cn

[Script]
http-request ^https://wxavip-tp\.ezrpro\.cn/Vip/SignIn/SignIn script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/klcw/klcw_capture.js, requires-body=true, tag=酷乐潮玩小程序每日签到抓取, enable={capture}
cron "5 0 * * *" script-path=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/check_in/klcw/klcw.js, timeout=300, tag=酷乐潮玩小程序每日签到, img-url=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/picture/klcw_tran.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=酷乐潮玩小程序去抓取, img-url=https://raw.githubusercontent.com/evilbutcher/Quantumult_X/master/picture/klcw_tran.png, argument="title=酷乐潮玩小程序&url=&hint=在微信里打开酷乐潮玩小程序，点一次签到", enable={capture}
