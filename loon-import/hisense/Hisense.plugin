#!name=海信爱家每日签到
#!desc=海信爱家每日签到；用法：装好插件，打开重写和 cron，打开海信爱家微信小程序，进入会员页，收到通知即抓取成功，抓完后在设置里关掉「抓取开关」；cron 每天 7:52 自动签到。\n手动抓取：点 Loon 脚本里的「海信爱家去抓取」，按弹出的提示操作。
#!author=許諾
#!icon=https://raw.githubusercontent.com/FoKit/Scripts/main/images/hisense.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开 App 会自动保存签到要用的 Cookie；抓完可以关掉

[MITM]
hostname = sweixin.hisense.com

[Script]
http-response ^https://sweixin\.hisense\.com/ecrp/member/initMember script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/hisense/hisense_capture.js, requires-body=true, tag=海信爱家每日签到抓取, enable={capture}
cron "52 7 * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-import/hisense/Hisense.js, timeout=300, tag=海信爱家每日签到, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/hisense.png, enable=true
cron "0 0 29 2 *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-fmz/fmz_open_capture.js, tag=海信爱家去抓取, img-url=https://raw.githubusercontent.com/FoKit/Scripts/main/images/hisense.png, argument="title=海信爱家&url=&hint=打开海信爱家微信小程序，进入会员页", enable={capture}
