#!name=法拉利每日签到
#!desc=法拉利每日签到领流量：每天先查签到状态，没签就自动领取，签到结果会通知你（签到时间在 BoxJs 里设置，默认 09:00，也可以指定时间或在时间区间内随机）。\n两种登录方式二选一：①账号密码：在 BoxJs 里填邮箱和密码，每天自动登录签到；②Token：打开本站一次自动抓取（只存账号1），或在 BoxJs 里粘贴 Token。两个都填优先账号密码。\n多账号：在 BoxJs「多账号」里每行一个 Token，或每行一个 邮箱；密码。\n账号密码和 Token 只保存在你手机本地，不会上传。
#!author=許諾
#!icon=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/falali.png
#!homepage=https://github.com/Crack22/loon-plugins

[Argument]
capture = switch,true,tag=Token抓取,desc=打开后，打开本站会自动抓取 Token；抓完可以关掉
manualRun = switch,false,tag=手动运行一次,desc=打开后运行一次，手动关闭

[Script]
cron "* * * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/8474ccd9ab5c989c2ceee3e2812b249e3b403d81/loon-falali/falali_checkin.js, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/falali.png, tag=法拉利签到, enable=true
cron "* * * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/8474ccd9ab5c989c2ceee3e2812b249e3b403d81/loon-falali/falali_checkin.js, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/falali.png, tag=手动运行一次, argument=[{manualRun}], enable={manualRun}
http-request ^https?://pop67xra\.faalaa\.cc/api/v1/user/ script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/8474ccd9ab5c989c2ceee3e2812b249e3b403d81/loon-falali/falali_token.js, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/falali.png, requires-body=false, tag=法拉利Token抓取, enable={capture}

[MITM]
hostname = pop67xra.faalaa.cc
