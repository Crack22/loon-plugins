#!name=网易云音乐每日签到
#!desc=网易云音乐每日签到，每天 +2 成长值；用法：开重写，打开网易云音乐 App 停 1 秒，收到 Cookie 获取成功即抓取成功。签到时间可在 BoxJs 里自定义（指定时间或区间随机），默认每天 09:00。\n注意：APP 端签到接口已停用，只能签网页端；云贝中心和 VIP 签到是加密接口，做不了自动签。
#!author=許諾
#!tag=网易云音乐
#!icon=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/netease.jpg
#!system=ios

# 用法：
# 1、安装插件，开启重写脚本 + cron
# 2、打开网易云音乐 App 停留 1 秒
# 3、收到 ✅ 网易云 Cookie 获取成功 通知即抓取成功
# 4、cron 每分钟检查，到了设定的时间自动签到（默认 09:00，可在 BoxJs 里改）
# 注意：Cookie 过期时重新打开 App 抓一次
[Argument]
capture = switch,true,tag=抓取开关,desc=打开后，打开网易云音乐 App 会自动保存签到要用的 Cookie；抓完可以关掉
manualRun = switch,false,tag=手动运行一次,desc=打开后运行一次，手动关闭

[MITM]
hostname = interface3.music.163.com

[Script]
http-request ^https:\/\/interface3\.music\.163\.com\/xeapi\/(nuser\/account\/get|v1\/user\/detail\/\d+) tag=网易云 Cookie, script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-netease/netease_cookie.js, requires-body=false, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/netease.jpg, argument=[{capture}], enable={capture}
cron "* * * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-netease/netease_checkin.js, tag=网易云音乐签到, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/netease.jpg, enable=true
cron "* * * * *" script-path=https://raw.githubusercontent.com/Crack22/loon-plugins/main/loon-netease/netease_checkin.js, tag=手动运行一次, img-url=https://raw.githubusercontent.com/Crack22/loon-plugins/main/icons/netease.jpg, argument=[{manualRun}], enable={manualRun}

